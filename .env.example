# ─── Server-side secrets (Netlify Functions / netlify dev) ─────────────────
# These are NOT prefixed with VITE_ — they are never bundled into client JS
# (the one exception, VITE_GOOGLE_CLIENT_ID, is public by design).
# Set them in Netlify → Site Settings → Environment Variables for production.
# For local development, set them here (.env is read automatically by netlify dev).

# ─── Accounts & sign-in ───────────────────────────────────────────────────
# Upstash Redis (REST) — REQUIRED. Stores accounts, invites, and sessions, and
# backs per-IP rate limiting. Create a free database at console.upstash.com
# (use a separate "dev" database for local work). Sign-in fails closed if unset.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Comma-separated emails allowed to send invites. They can sign in without an
# invite (their account is created on first sign-in).
INVITER_EMAILS=you@example.com,another.deacon@example.com

# Resend (resend.com) — sends invite, confirmation, and sign-in emails.
# EMAIL_FROM's domain must be verified in Resend (SPF/DKIM DNS records).
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=OGC Deacons <noreply@your-church-domain.org>

# Google sign-in (optional). OAuth client ID (Web) from Google Cloud Console.
# GOOGLE_CLIENT_ID is used server-side to verify ID tokens. VITE_GOOGLE_CLIENT_ID
# is the same value, bundled into the client — the one deliberate VITE_ var
# (OAuth client IDs are public by design). Leave both unset to hide the button.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Base URL for links in emails. Optional — defaults to Netlify's built-in URL
# (production) or http://localhost:8888. Set it in Netlify's deploy-preview
# context to test emails from a preview (Netlify's URL always points at prod).
# APP_URL=http://localhost:8888

# ─── Integrations ─────────────────────────────────────────────────────────
# Asana Personal Access Token (Settings → Apps → Personal access tokens)
ASANA_PAT=your-pat-here

# GID of the "OGC Deacons" Asana project
# Find it in the project URL: app.asana.com/0/<PROJECT_GID>/...
ASANA_PROJECT_GID=your-project-gid-here

# GID of the "Inbox" section inside that project
# Fetch via: GET https://app.asana.com/api/1.0/projects/<PROJECT_GID>/sections
ASANA_INBOX_SECTION_GID=your-section-gid-here

ANTHROPIC_API_KEY=your-key-here

# Notion internal integration token (read-only, scoped to roster DB)
# Create at: notion.so/my-integrations
NOTION_TOKEN=your-notion-integration-token-here

# GID of the Notion database containing the deacon roster
# Get it from the database URL: notion.so/<WORKSPACE>/<DATABASE_ID>?v=...
NOTION_ROSTER_DB_ID=your-notion-database-id-here
